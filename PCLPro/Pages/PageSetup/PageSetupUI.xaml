<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageSetupUI"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15" Title="基础" x:Name="CardLauncher">
                <Grid Margin="25,40,25,17">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Name1" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="界面样式" Margin="0,0,20,0" />
                            <local:MyComboBox local:SettingService.Key="UiUiStyle" Grid.Column="1" Height="28" Width="160" HorizontalAlignment="Left"
                                              ToolTip="简洁版为当前的平面样式；毛玻璃版使用半透明磨砂卡片与玻璃质感弹窗。切换后重启启动器可完全生效。">
                                <local:MyComboBoxItem local:SettingService.Value="0" Content="简洁版" />
                                <local:MyComboBoxItem local:SettingService.Value="1" Content="毛玻璃版" />
                            </local:MyComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Name1" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="界面字体" Margin="0,0,20,0" />
                            <local:MyComboBox x:Name="ComboFontFamily" Grid.Column="1" Height="28" Width="200" HorizontalAlignment="Left"
                                              ToolTip="把启动器界面换成更清晰、更粗或更喜欢的字体。背景调成全透明时文字容易看不清，换一款字重更明显的字体可以改善阅读。" />
                            <local:MyButton x:Name="BtnFontImport" Grid.Column="2" Text="导入字体…" MinWidth="100" Padding="13,0" Margin="12,0,0,0"
                                            ToolTip="导入本地的 ttf / otf / ttc 字体文件，会复制到启动器的字体文件夹，并立即加入上方列表。" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Name1" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="字体颜色" Margin="0,0,20,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle x:Name="RectFontColor" Width="20" Height="20" RadiusX="5" RadiusY="5"
                                           Stroke="{DynamicResource ColorBrushGray5}" StrokeThickness="1" VerticalAlignment="Center" />
                                <local:MyButton x:Name="BtnFontColor" Text="选择颜色…" MinWidth="100" Height="28" Padding="13,0" Margin="12,0,0,0"
                                                ToolTip="自定义界面文字颜色。浅色壁纸配深色文字，深色或全透明背景配浅色文字更清楚。" />
                            </StackPanel>
                            <local:MyButton x:Name="BtnFontColorReset" Grid.Column="2" Text="跟随主题" MinWidth="90" Height="28" Padding="13,0" Margin="10,0,0,0"
                                            ToolTip="恢复为当前主题的默认文字颜色。" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Name1" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="字体大小" Margin="0,0,20,0" />
                            <local:MySlider x:Name="SliderFontSize" Grid.Column="1" MaxValue="8" ValueByKey="1"
                                            ToolTip="调整界面文字大小，范围 10 ~ 18，避免调得过大后无法在设置里改回来。" />
                            <TextBlock x:Name="LabFontSize" Grid.Column="2" Text="13" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Name1" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="不透明度" Margin="0,0,20,0" />
                            <local:MySlider local:SettingService.Key="UiLauncherTransparent"
                                            MaxValue="600" ValueByKey="10" Grid.ColumnSpan="5" x:Name="SliderLauncherTransparent" Grid.Column="1" />
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Name="LabLauncherHue" Visibility="Collapsed" HorizontalAlignment="Left" Text="色调" Margin="0,10,20,0" />
                            <local:MySlider local:SettingService.Key="UiLauncherHue"
                                            Grid.Row="1" Grid.Column="1" x:Name="SliderLauncherHue" Visibility="Collapsed" MaxValue="360" ValueByKey="10" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Name="LabLauncherDelta" Visibility="Collapsed" HorizontalAlignment="Left" Text="色调渐变" Margin="0,10,20,0" />
                            <local:MySlider local:SettingService.Key="UiLauncherDelta"
                                            Grid.Row="2" Grid.Column="1" x:Name="SliderLauncherDelta" Visibility="Collapsed" MaxValue="180" ValueByKey="5" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Name="LabLauncherSat" Visibility="Collapsed" HorizontalAlignment="Left" Text="饱和度" Margin="0,10,20,0" />
                            <local:MySlider local:SettingService.Key="UiLauncherSat"
                                            Grid.Row="1" Grid.Column="4" x:Name="SliderLauncherSat" Visibility="Collapsed" MaxValue="100" ValueByKey="5" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" Name="LabLauncherLight" Visibility="Collapsed" HorizontalAlignment="Left" Text="亮度" Margin="0,10,20,0" />
                            <local:MySlider local:SettingService.Key="UiLauncherLight"
                                            Grid.Row="2" Grid.Column="4" x:Name="SliderLauncherLight" Visibility="Collapsed" MaxValue="40" ValueByKey="5" Margin="0,10,0,0" />
                        </Grid>
                        <Grid x:Name="PanLauncherTheme" Height="90" Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Name1" />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="主题" Margin="0,0,20,0" />
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="隐藏主题" Margin="0,0,20,0" Grid.Row="1" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="0"
                                              Grid.Column="1" Grid.Row="0" Text="龙猫蓝" x:Name="RadioLauncherTheme0" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="1"
                                              Grid.Column="2" Grid.Row="0" Text="甜柠青" x:Name="RadioLauncherTheme1" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="2"
                                              Grid.Column="3" Grid.Row="0" Text="小草绿" x:Name="RadioLauncherTheme2" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="3"
                                              Grid.Column="4" Grid.Row="0" Text="菠萝黄" x:Name="RadioLauncherTheme3" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="4"
                                              Grid.Column="5" Grid.Row="0" Text="橡木棕" x:Name="RadioLauncherTheme4" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="5"
                                              Grid.Column="1" Grid.Row="1" Text="玄素黑" x:Name="RadioLauncherTheme5" ToolTip="灰色是个谎言" />
                            <local:MyRadioBox Grid.Column="1" Grid.Row="1" Text="玄素黑" x:Name="RadioLauncherTheme5Gray" IsEnabled="False" Opacity="1" Visibility="Collapsed" />
                            <TextBlock Grid.Column="1" Grid.Row="1" x:Name="LabLauncherTheme5Unlock" Visibility="Collapsed" Background="{StaticResource ColorBrushSemiTransparent}" ToolTip="灰色是个谎言" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="12"
                                              Grid.Column="2" Grid.Row="1" Text="滑稽彩" x:Name="RadioLauncherTheme12" ToolTip="滑稽树上滑稽果，滑稽树下你和我，滑稽之日搞事情，欢乐多又多" ToolTipService.ShowOnDisabled="True" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="6"
                                              Grid.Column="3" Grid.Row="1" Text="铁杆粉" x:Name="RadioLauncherTheme6" ToolTip="99 次重逢的喜悦" ToolTipService.ShowOnDisabled="True" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="7"
                                              Grid.Column="4" Grid.Row="1" Text="神秘紫" x:Name="RadioLauncherTheme7" ToolTip="072 101 108 112 032 068 101 118 032 048 046 052 046 052" ToolTipService.ShowOnDisabled="True" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="13"
                                              Grid.Column="5" Grid.Row="1" Text="欧皇彩" x:Name="RadioLauncherTheme13" ToolTip="这就是传说中的欧皇了吧" ToolTipService.ShowOnDisabled="True" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="8"
                                              Grid.Column="1" Grid.Row="2" Text="秋仪金" x:Name="RadioLauncherTheme8" />
                            <TextBlock Grid.Column="1" Grid.Row="2" x:Name="LabLauncherTheme8Copy" Visibility="Collapsed" Background="{StaticResource ColorBrushSemiTransparent}" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="9"
                                              Grid.Column="2" Grid.Row="2" Text="活跃橙" x:Name="RadioLauncherTheme9" />
                            <TextBlock Grid.Column="2" Grid.Row="2" x:Name="LabLauncherTheme9Copy" Visibility="Collapsed" Background="{StaticResource ColorBrushSemiTransparent}" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="10"
                                              Grid.Column="3" Grid.Row="2" Text="跳票红" x:Name="RadioLauncherTheme10" ToolTip="进行一次正版登录，支持正版游戏！" ToolTipService.ShowOnDisabled="True" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="11"
                                              Grid.Column="4" Grid.Row="2" Text="极客蓝" x:Name="RadioLauncherTheme11" ToolTip="右键打开解密游戏入口" />
                            <TextBlock Grid.Column="4" Grid.Row="2" x:Name="LabLauncherTheme11Click" Visibility="Collapsed" Background="{StaticResource ColorBrushSemiTransparent}" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="14"
                                              Grid.Column="5" Grid.Row="2" Text="自定义" x:Name="RadioLauncherTheme14" ToolTip="需要解锁五个隐藏主题" ToolTipService.ShowOnDisabled="True" />
                        </Grid>

                        <local:MyCheckBox local:SettingService.Key="UiLauncherLogo" Text="打开启动器时显示 PCL 图标" Margin="-1,0,0,1" Height="22" />
                    </StackPanel>
                    <Border Background="#DDDDDDDD" Margin="-8,23,-5,28" CornerRadius="4" Name="PanLauncherHide" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="如果可以小小赞助一下 PCL PE，就能解锁主题颜色更换功能啦……&#xa;多亏了大家的支持，PCL PE 才能在免费、无任何广告的情况下维持数年的更新（磕头）！" FontSize="13" Margin="0,0,0,0" />
                            <local:MyButton Height="32" MinWidth="140" Text="支持 PCL 开发！" Padding="13,0" HorizontalAlignment="Center" Margin="0,9,0,0" ColorType="Highlight"
                                            local:CustomEventService.EventType="打开网页" local:CustomEventService.EventData="https://meloong.com/afd/a/LTCat" />
                        </StackPanel>
                    </Border>
                </Grid>
            </local:MyCard>
            <local:MyCard x:Name="CardPersonalize" Margin="0,0,0,15" Title="个性化">
                <StackPanel Margin="25,40,25,17">
                    <Grid Height="28" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name1" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="窗口圆角" Margin="0,0,20,0" />
                        <local:MyComboBox local:SettingService.Key="UiWindowRadius" Grid.Column="1" Height="28" Width="140" HorizontalAlignment="Left">
                            <local:MyComboBoxItem local:SettingService.Value="0" Content="直角" />
                            <local:MyComboBoxItem local:SettingService.Value="6" Content="小圆角" />
                            <local:MyComboBoxItem local:SettingService.Value="10" Content="中圆角" />
                            <local:MyComboBoxItem local:SettingService.Value="14" Content="大圆角" />
                        </local:MyComboBox>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="动画速度" Margin="20,0,20,0" />
                        <local:MyComboBox local:SettingService.Key="UiAnimationSpeed" Grid.Column="3" Height="28" Width="140" HorizontalAlignment="Left">
                            <local:MyComboBoxItem local:SettingService.Value="0" Content="缓慢" />
                            <local:MyComboBoxItem local:SettingService.Value="1" Content="标准" />
                            <local:MyComboBoxItem local:SettingService.Value="2" Content="快速" />
                            <local:MyComboBoxItem local:SettingService.Value="3" Content="关闭动画" />
                        </local:MyComboBox>
                    </Grid>
                    <Grid Height="28" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name1" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="窗口透明度" Margin="0,0,20,0" />
                        <local:MyComboBox local:SettingService.Key="UiWindowOpacity" Grid.Column="1" Height="28" Width="140" HorizontalAlignment="Left">
                            <local:MyComboBoxItem local:SettingService.Value="100" Content="不透明" />
                            <local:MyComboBoxItem local:SettingService.Value="95" Content="轻微透明" />
                            <local:MyComboBoxItem local:SettingService.Value="90" Content="半透明" />
                            <local:MyComboBoxItem local:SettingService.Value="85" Content="更透明" />
                        </local:MyComboBox>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="标题栏高度" Margin="20,0,20,0" />
                        <local:MyComboBox local:SettingService.Key="UiTitleBarHeight" Grid.Column="3" Height="28" Width="140" HorizontalAlignment="Left">
                            <local:MyComboBoxItem local:SettingService.Value="40" Content="紧凑" />
                            <local:MyComboBoxItem local:SettingService.Value="48" Content="标准" />
                            <local:MyComboBoxItem local:SettingService.Value="56" Content="宽松" />
                        </local:MyComboBox>
                    </Grid>
                    <local:MyCheckBox Height="22" Margin="-1,0,0,0" Text="启动器窗口始终置顶" local:SettingService.Key="UiWindowTopmost" />
                    <local:MyCheckBox Height="22" Margin="-1,6,0,0" Text="启动时播放窗口展开动画" local:SettingService.Key="UiStartAnimation"
                                      ToolTip="关闭后启动器直接呈现主界面，不做缩放与淡入动画。" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardBackground" Margin="0,0,0,15" Title="背景图片">
                <StackPanel Margin="25,40,25,20">
                    <Grid x:Name="PanBackgroundSuit" Height="28" Margin="0,0,0,10" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="自适应方式" Margin="0,0,25,0" />
                        <local:MyComboBox local:SettingService.Key="UiBackgroundSuit" Grid.Column="1">
                            <local:MyComboBoxItem local:SettingService.Value="0" Content="自动" ToolTip="当图片较小时选择平铺，较大时选择居中 (保持长宽比)" />
                            <local:MyComboBoxItem local:SettingService.Value="4" Content="平铺" />
                            <local:MyComboBoxItem local:SettingService.Value="1" Content="居中" />
                            <local:MyComboBoxItem local:SettingService.Value="3" Content="拉伸" ToolTip="拉伸图片使其恰好填满整个窗口，很可能会导致长宽比的改变" />
                            <local:MyComboBoxItem local:SettingService.Value="5" Content="左上 (保持长宽比)" />
                            <local:MyComboBoxItem local:SettingService.Value="9" Content="左中 (保持长宽比)" />
                            <local:MyComboBoxItem local:SettingService.Value="7" Content="左下 (保持长宽比)" />
                            <local:MyComboBoxItem local:SettingService.Value="11" Content="中上 (保持长宽比)" />
                            <local:MyComboBoxItem local:SettingService.Value="2" Content="居中 (保持长宽比)" />
                            <local:MyComboBoxItem local:SettingService.Value="12" Content="中下 (保持长宽比)" />
                            <local:MyComboBoxItem local:SettingService.Value="6" Content="右上 (保持长宽比)" />
                            <local:MyComboBoxItem local:SettingService.Value="10" Content="右中 (保持长宽比)" />
                            <local:MyComboBoxItem local:SettingService.Value="8" Content="右下 (保持长宽比)" />
                        </local:MyComboBox>
                    </Grid>
                    <Grid x:Name="PanBackgroundOpacity" Height="22" Margin="0,0,0,7" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="不透明度" Margin="0,0,25,0" />
                        <local:MySlider local:SettingService.Key="UiBackgroundOpacity" x:Name="SliderBackgroundOpacity" MaxValue="1000" ValueByKey="10" Grid.Column="1" />
                    </Grid>
                    <Grid x:Name="PanBackgroundBlur" Height="22" Margin="0,0,0,10" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="背景模糊" Margin="0,0,25,0" />
                        <local:MySlider local:SettingService.Key="UiBackgroundBlur" x:Name="SliderBackgroundBlur" MaxValue="40" Grid.Column="1"
                                        ToolTip="只模糊背景图片本身，不影响界面对话框的模糊（那个是「UI 模糊」）。&#13;高度的模糊会严重掉帧，请谨慎使用。" />
                    </Grid>
                    <local:MyCheckBox local:SettingService.Key="UiBackgroundColorful" Text="叠加彩色背景" Margin="-1,0,0,8" Height="22" />
                    <Grid Height="35" Margin="0,2,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnBackgroundPick" MinWidth="140" Text="选择图片壁纸…" Padding="13,0" Margin="0,0,20,0"
                                        ToolTip="选择一个本地图片（png / jpg / jpeg / bmp / gif / webp）作为背景图片，会自动复制到启动器的图片文件夹。" />
                        <local:MyButton x:Name="BtnBackgroundOpen" MinWidth="140" Text="打开图片文件夹" Padding="13,0" Margin="0,0,20,0" Grid.Column="1" ToolTip="将背景图片放到该文件夹，PCL 将会在每次打开时随机加载其中的一张图片"/>
                        <local:MyButton x:Name="BtnBackgroundRefresh" MinWidth="140" Text="刷新背景图片" Padding="13,0" Margin="0,0,20,0" ToolTip="重新加载当前这张背景图片，不会换成文件夹里的其它图片。" Grid.Column="2"/>
                    </Grid>
                    <Grid Height="35" Margin="0,2,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnVideoBackgroundPick" MinWidth="140" Text="选择视频背景…" Padding="13,0" Margin="0,0,20,0"
                                        ToolTip="选择一个本地视频（mp4 / mov / wmv / avi / mkv / webm / flv 等）作为启动器动态背景。不支持的格式会提示下载 FFmpeg 后自动转换。视频会被复制到启动器目录，原文件移动后也不会失效。" />
                        <local:MyButton x:Name="BtnVideoBackgroundReset" MinWidth="140" Text="使用静态壁纸" Padding="13,0" Margin="0,0,20,0" ColorType="Red" Grid.Column="1"
                                        ToolTip="关闭视频背景，恢复为背景图片或默认壁纸。" />
                        <local:MyButton x:Name="BtnBackgroundClear" MinWidth="140" Text="清空背景图片" Visibility="Collapsed" Padding="13,0" Margin="0,0,20,0" ColorType="Red" Grid.Column="2"/>
                    </Grid>
                    <Grid Height="20" Margin="0,0,0,0">
                        <TextBlock x:Name="LabVideoBackground" VerticalAlignment="Center" HorizontalAlignment="Left" Opacity="0.7" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardGlass" Margin="0,0,0,15" Title="毛玻璃" Visibility="Collapsed">
                <StackPanel Margin="25,40,25,16">
                    <Grid Height="22" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="UI 模糊" Margin="0,0,25,0" />
                        <local:MySlider local:SettingService.Key="UiUiBlur" x:Name="SliderUiBlur" MaxValue="60" Grid.Column="1"
                                        ToolTip="毛玻璃弹窗背后那一整张界面（卡片、文字、壁纸）的模糊程度，这才是毛玻璃的关键参数。&#13;0 表示玻璃后面完全是清晰的，数值越大越朦胧。" />
                    </Grid>
                    <Grid Height="22" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
